{
  "name": "@trainlcd/decision-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --loader ./scripts/wasm-test-loader.mjs --test dist-test/test/*.test.js && node --test test/*.test.mjs",
    "db:local": "wrangler d1 migrations apply trainlcd-decision-rag --local",
    "db:remote": "wrangler d1 migrations apply trainlcd-decision-rag --remote",
    "build:pwa": "node scripts/build-pwa.mjs",
    "predeploy": "npm run build:pwa",
    "build:rust": "node scripts/build-rust.mjs",
    "test:rust": "cargo test --workspace --locked",
    "pretest": "npm run build:rust",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/node": "22.20.5",
    "jsdom": "^31.0.0",
    "marked": "18.1.3",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "wrangler": "4.158.0"
  }
}
