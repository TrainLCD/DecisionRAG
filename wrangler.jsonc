{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trainlcd-decision-rag",
  "main": "src/index.ts",
  "assets": { "directory": "./public" },
  "compatibility_date": "2026-11-06",
  "workers_dev": false,
  "vars": {
    "GITHUB_ORG": "TrainLCD",
    "JEV_MODEL": "jev-latest",
    "ANSWER_MODEL": "",
    "ANSWER_BASE_URL": "https://api.openai.com/v1",
    "SUPPORT_THRESHOLD": "0.85",
    "CONFLICT_THRESHOLD": "0.7",
    "MAX_SCREENED_DOCUMENTS": "20000"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "trainlcd-decision-rag",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "trainlcd-rag-sync" }],
    "consumers": [{ "queue": "trainlcd-rag-sync", "max_batch_size": 1, "max_retries": 5, "dead_letter_queue": "trainlcd-rag-sync-dlq" }]
  },
  "triggers": { "crons": ["17 */6 * * *"] },
  "observability": { "enabled": true }
}
